# ============ 客户端鉴权(必填)============
# 允许访问本代理的 API Key,逗号分隔多个。new-api 渠道里填其中任意一个。
PROXY_API_KEYS=sk-opencode-proxy-please-change-me

# ============ 监听 ============
PORT=8787
# HOST=0.0.0.0

# ============ 上游(一般不用改)============
# OpenCode Zen 网关(OpenAI 兼容:chat/completions、responses;Anthropic 兼容:messages)
UPSTREAM_BASE=https://opencode.ai/zen/v1
# OpenCode 控制台(设备码授权 + 令牌刷新)
CONSOLE_BASE=https://console.opencode.ai
OAUTH_CLIENT_ID=opencode-cli

# ============ 出站代理 ============
# 访问上游与控制台的出站代理;支持 http:// https:// socks5:// socks5h://,可带用户名密码
# 示例:
#   UPSTREAM_PROXY=http://127.0.0.1:7890
#   UPSTREAM_PROXY=http://user:pass@proxy.example.com:8080
#   UPSTREAM_PROXY=socks5://127.0.0.1:1080
# 不设置则直连;也可部署后在 Web 控制台"出站代理"卡片里运行时修改(持久化到 data/proxy.json,env 优先)
UPSTREAM_PROXY=

# ============ Zen 通道授权模式 ============
# public = 匿名(Bearer public 官方匿名层,仅免费模型,零登录零授权)
# oauth  = OpenCode 账号设备码授权(免费+付费模型)
# auto   = 有授权令牌用 oauth,否则自动用 public(默认)
AUTH_MODE=auto

# ============ GitHub Copilot 通道(可选) ============
# 启用后:模型名加 copilot/ 前缀(如 copilot/gpt-5.1)或 X-Channel: copilot 头路由;
# 用自己的 GitHub 账号在 github.com/login/device 完成设备码授权(需 Copilot 订阅)
COPILOT_ENABLED=0

# ============ 令牌自动刷新 ============
# 每隔多少分钟检查并刷新一次令牌(默认 20)
TOKEN_REFRESH_MINUTES=20
# 令牌到期前多少秒开始主动刷新(默认 300)
REFRESH_BEFORE_SECONDS=300

# ============ 流式保活 ============
# SSE 空闲多少秒后向客户端发送心跳注释行(: keepalive),防止中间层掐断长间隔流(默认 15)
KEEPALIVE_SECONDS=15
# 上游流式连续无数据多久判定死流并断开,毫秒(默认 600000 = 10 分钟)
STREAM_IDLE_TIMEOUT_MS=600000
# 等待上游响应头的超时,毫秒(默认 300000;推理模型首包慢可调大)
HEADER_TIMEOUT_MS=300000

# ============ 并发与重试(压 429)============
MAX_CONCURRENCY=8
QUEUE_TIMEOUT_MS=120000
# 上游 429 自动退避重试次数(遵守 Retry-After)
RETRY_429=3
RETRY_5XX=1
RETRY_NETWORK=2

# ============ 主动限速(令牌桶,超速直接 429+Retry-After,不惊动上游)============
# 免费模型(*-free 后缀)每分钟请求上限;上游对免费层按 IP 约 40RPM,建议 30 左右留余量。0=不限
RATE_LIMIT_FREE_RPM=30
# 全局每分钟请求上限(所有模型合计)。0=不限
RATE_LIMIT_GLOBAL_RPM=0
# 突发容量(令牌桶大小,允许短时突发)
RATE_LIMIT_BURST=5

# ============ 可选:导入现有 opencode CLI 凭证跳过首次授权 ============
# 内容为 ~/.local/share/opencode/auth.json 里的 opencode 条目,或 {"access_token":"...","refresh_token":"..."}
# 示例: BOOTSTRAP_AUTH_JSON={"access_token":"eyJ...","refresh_token":"rt_...","expires_at":1755300000000}
BOOTSTRAP_AUTH_JSON=

# ============ 其他 ============
# DATA_DIR=./data
# MAX_BODY_MB=100
